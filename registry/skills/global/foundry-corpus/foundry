    print(out)


# ============================================================ STATUS (organ health)
def cmd_status(a):
    # one round-trip script for all freshness signals
    script = r'''
IDENT="$HOME/foundry-data/domains/github/identity/identity.sqlite"
QUEUE="$HOME/Projects/youtube-ai-research/database/queue.db"
INS="$HOME/Projects/research-os/insights.db"
PPL="$HOME/foundry-data/domains/people/people.sqlite"
echo "repo_cards|$(sqlite3 "file:$IDENT?mode=ro" 'SELECT COUNT(*) FROM repo_card')"
echo "categorized|$(sqlite3 "file:$IDENT?mode=ro" 'SELECT COUNT(DISTINCT full_name) FROM repo_category')"
echo "saucy|$(sqlite3 "file:$IDENT?mode=ro" 'SELECT COUNT(*) FROM repo_category WHERE saucy=1')"
echo "last_categorize|$(sqlite3 "file:$IDENT?mode=ro" 'SELECT MAX(built_at) FROM repo_category')"
echo "categorizer_loaded|$(launchctl list 2>/dev/null | grep -q foundry-github-categorize && echo yes || echo no)"
echo "transcripts_done|$(sqlite3 "file:$QUEUE?mode=ro" "SELECT COUNT(*) FROM video_queue WHERE status='completed'")"
echo "transcripts_failed|$(sqlite3 "file:$QUEUE?mode=ro" "SELECT COUNT(*) FROM video_queue WHERE status='failed'")"
echo "last_transcript|$(sqlite3 "file:$QUEUE?mode=ro" "SELECT MAX(updated_at) FROM video_queue WHERE status='completed'")"
echo "ytworker_loaded|$(launchctl list 2>/dev/null | grep -q youtube-worker && echo yes || echo no)"
echo "insights|$(sqlite3 "file:$INS?mode=ro" 'SELECT COUNT(*) FROM insights')"
echo "last_insight|$(sqlite3 "file:$INS?mode=ro" 'SELECT MAX(last_seen_date) FROM insights')"
echo "people|$(sqlite3 "file:$PPL?mode=ro" 'SELECT COUNT(*) FROM person')"
'''
    out = _run(script)
    d = {}
    for line in out.strip().splitlines():
        if "|" in line:
            k, _, v = line.partition("|")
            d[k] = v
    def human():
        print("# Foundry information organ — health (read live off the mini)")
        print(f"  GitHub corpus:  {d.get('repo_cards','?'):>10} cards  {d.get('categorized','?'):>9} categorized  {d.get('saucy','?'):>7} saucy")
        print(f"                  last categorize write: {d.get('last_categorize','?')}   categorizer loaded: {d.get('categorizer_loaded','?')}")
        print(f"  Transcripts:    {d.get('transcripts_done','?'):>10} done   {d.get('transcripts_failed','?'):>9} failed")
        print(f"                  last transcript:       {d.get('last_transcript','?')}   worker loaded: {d.get('ytworker_loaded','?')}")
        print(f"  Insights:       {d.get('insights','?'):>10}   last: {d.get('last_insight','?')}")
        print(f"  People graph:   {d.get('people','?'):>10} people")
    _emit(d, a.json, human)


def build_parser():
    p = argparse.ArgumentParser(prog="foundry",
        description="Read-only query primitive over the whole Foundry information organ (repos·transcripts·insights·people) on the Mac mini.",
        epilog="Read-only (single-writer law). --json on any subcommand for a machine contract.")
    p.add_argument("--json", action="store_true")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("repos", parents=[common], help="search GitHub corpus: repos that do X")
    sp.add_argument("query"); sp.add_argument("--lang"); sp.add_argument("--category")
    sp.add_argument("--saucy", action="store_true"); sp.add_argument("--min-stars", type=int, default=0, dest="min_stars")
    sp.add_argument("--limit", type=int, default=20); sp.set_defaults(fn=cmd_repos)

    rp = sub.add_parser("repo", parents=[common], help="one repo: card + value categories + why")
    rp.add_argument("name"); rp.set_defaults(fn=cmd_repo)

    cp = sub.add_parser("category", parents=[common], help="list the 264-cat taxonomy, or repos in one")
    cp.add_argument("name", nargs="?"); cp.add_argument("--saucy", action="store_true")
    cp.add_argument("--limit", type=int, default=30); cp.set_defaults(fn=cmd_category)

    tp = sub.add_parser("transcripts", parents=[common], help="search YouTube creator videos/transcripts")
    tp.add_argument("query"); tp.add_argument("--channel"); tp.add_argument("--done", action="store_true", help="only videos with a fetched transcript")
    tp.add_argument("--limit", type=int, default=20); tp.set_defaults(fn=cmd_transcripts)

    tb = sub.add_parser("transcript", parents=[common], help="fetch one transcript body by video_id")
    tb.add_argument("video_id"); tb.add_argument("--head", type=int, default=0, help="first N lines only")
    tb.set_defaults(fn=cmd_transcript)

    ip = sub.add_parser("insights", parents=[common], help="FTS the mined self-learning corpus (news/YT/GitHub)")
    ip.add_argument("query"); ip.add_argument("--lane", help="github | youtube")
    ip.add_argument("--min-action", type=int, default=0, dest="min_action", help="min actionability 0-5")
    ip.add_argument("--limit", type=int, default=15); ip.set_defaults(fn=cmd_insights)

    pp = sub.add_parser("people", parents=[common], help="god-source creator/people graph (name, or list top)")
    pp.add_argument("name", nargs="?"); pp.add_argument("--limit", type=int, default=25); pp.set_defaults(fn=cmd_people)

    rsp = sub.add_parser("research", parents=[common], help="L4: fan MiniMax over a God-source slice on the mini, synthesize an answer")
    rsp.add_argument("question")
    rsp.add_argument("--category", help="restrict slice to a category (fuzzy)")
    rsp.add_argument("--saucy", action="store_true", help="saucy repos only")
    rsp.add_argument("--limit", type=int, default=200, help="max repos in the slice")
    rsp.add_argument("--deep", type=int, default=36, help="repos to deep-read (1 MiniMax call each)")
    rsp.add_argument("--max-calls", type=int, default=40, dest="max_calls")
    rsp.set_defaults(fn=cmd_research)

    sgp = sub.add_parser("signal", parents=[common], help="the organ's daily push: health + movers + fresh insights + new answers")
    sgp.set_defaults(fn=cmd_signal)

    stp = sub.add_parser("status", parents=[common], help="freshness/health of every collector")
    stp.set_defaults(fn=cmd_status)

    # back-compat: `stats` == repos-only stats via status
    stt = sub.add_parser("stats", parents=[common], help="(alias) corpus stats — see `status` for the full organ")
    stt.set_defaults(fn=cmd_status)
    return p


def main():
    p = build_parser()
    a = p.parse_args()
    if not getattr(a, "json", False):
        a.json = "--json" in sys.argv
    try:
        a.fn(a)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
