#!/usr/bin/env python3
"""
skills_hub CLI - Manage SISO skills
"""
import argparse
import json
import os
import shutil
import sys
import time
import re
import tempfile
from contextlib import ExitStack
from pathlib import Path

HUB_ROOT = Path(__file__).parent.parent

# Import telemetry SDK
try:
    from skills_telemetry import track
    TELEMETRY_ENABLED = True
except ImportError:
    TELEMETRY_ENABLED = False
REGISTRY_FILE = HUB_ROOT / "registry/skills_registry.json"
SKILLS_DIR = HUB_ROOT / "registry/skills"
SAFE_ID = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
RUNTIME_NAMES = {".git", "node_modules", "state.json"}
RUNTIME_SUFFIXES = (".db", ".db-wal", ".db-shm", ".sqlite", ".sqlite3", ".sqlite-wal", ".sqlite-shm", ".jsonl", ".ndjson", ".pem", ".key", ".p12")
SECRET_NAMES = ("id_rsa", "id_ed25519", "credentials.json", "secrets.json")
REFRESH_ARCHIVE = Path.home() / ".agents" / "_archive"


def source_root(entry):
    if not entry.get('source_path'):
        return SKILLS_DIR.resolve()
    repo = HUB_ROOT.resolve().parents[2]
    relative = _safe_relative(entry['source_path'], 'module source')
    candidate = repo / relative
    if not candidate.resolve().is_relative_to(repo) or any(p.is_symlink() for p in [candidate, *candidate.parents] if p != repo.parent):
        raise ValueError('module source escapes repository or uses a symlink')
    return candidate.resolve()


def source_files(entry, skill_dir):
    if not entry.get('source_path'):
        return list(skill_dir.rglob('*'))
    # Module-owned capabilities retain their owner. Only declared support files
    # are projected; research payloads and runtime state never enter an install.
    return [skill_dir / _safe_relative(v, 'install file') for v in entry['files']['required']]


def _safe_relative(value, label):
    if not isinstance(value, str) or not value or Path(value).is_absolute():
        raise ValueError(f"invalid {label} path")
    path = Path(value)
    if any(part in ("", ".", "..") for part in path.parts):
        raise ValueError(f"invalid {label} path")
    return path


def _validate_source(skill_id, entry, skill_dir, check_location=True):
    if not SAFE_ID.fullmatch(skill_id):
        raise ValueError(f"invalid skill ID: {skill_id}")
    category = entry.get("category")
    if not isinstance(category, str) or not SAFE_ID.fullmatch(category):
        raise ValueError(f"invalid category for {skill_id}")
    if skill_dir is None:
        raise ValueError("registered skill source is unavailable")
    allowed_root = source_root(entry)
    resolved_dir = skill_dir.resolve()
    if check_location and resolved_dir != allowed_root and not str(resolved_dir).startswith(str(allowed_root) + os.sep):
        raise ValueError("skill path escapes the registered source root")
    if not skill_dir.is_dir() or skill_dir.is_symlink():
        raise ValueError("skill source must be a real directory")
    required = entry.get("files", {}).get("required", ["SKILL.md"])
    for value in required:
        rel = _safe_relative(value, "required")
        path = skill_dir / rel
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"missing or unsafe required file: {value}")
        if not path.resolve().is_relative_to(skill_dir.resolve()) or any(p.is_symlink() for p in path.parents if p != skill_dir.parent):
            raise ValueError(f"required file escapes source or uses a symlink: {value}")
    text = (skill_dir / "SKILL.md").read_text(encoding="utf-8")
    if not text.startswith("---\n") or "\n---\n" not in text[4:]:
        raise ValueError("SKILL.md requires YAML frontmatter")
    header = text[4:text.index("\n---\n", 4)]
    fields = {line.split(":", 1)[0].strip() for line in header.splitlines() if ":" in line}
    values = {}
    for line in header.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip().strip("'\"")
    if not {"name", "description"}.issubset(fields) or not values.get("name") or not values.get("description"):
        raise ValueError("SKILL.md frontmatter requires name and description")
    for path in source_files(entry, skill_dir):
        rel = path.relative_to(skill_dir)
        if any(part in ("", ".", "..") for part in rel.parts):
            raise ValueError("unsafe source path")
        if path.name in RUNTIME_NAMES or path.name in SECRET_NAMES or path.name == '.env' or path.name.startswith('.env.') or path.name.endswith(RUNTIME_SUFFIXES):
            raise ValueError(f"runtime or secret payload is not installable: {rel}")
        if path.is_symlink():
            resolved = path.resolve()
            if not str(resolved).startswith(str(skill_dir.resolve()) + os.sep):
                raise ValueError(f"symlink escapes skill source: {rel}")


def _same_projection(left, right):
    if left.is_symlink() or right.is_symlink():
        return left.is_symlink() and right.is_symlink() and os.readlink(left) == os.readlink(right)
    if left.is_dir() != right.is_dir() or left.is_file() != right.is_file():
        return False
    if left.is_file():
        return left.read_bytes() == right.read_bytes()
    left_items = {p.name for p in left.iterdir()}
    right_items = {p.name for p in right.iterdir()}
    return left_items == right_items and all(_same_projection(left / n, right / n) for n in left_items)


def _skill_name(skill_dir):
    """Frontmatter name of the copy at skill_dir, or None when it has no SKILL.md frontmatter."""
    try:
        text = (skill_dir / "SKILL.md").read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    if not text.startswith("---\n") or "\n---\n" not in text[4:]:
        return None
    for line in text[4:text.index("\n---\n", 4)].splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "name":
            return value.strip().strip("'\"")
    return None


def _outdated_copy(target_dir, skill_dir, skill_id):
    """True only for a real copy of this same skill id whose content differs from the source."""
    return (target_dir.is_dir() and not target_dir.is_symlink() and _skill_name(target_dir) == skill_id
            and not _same_projection(skill_dir, target_dir))


def _archive_outdated(target_dir, skill_id):
    """Move an outdated copy aside under the dated refresh archive; never delete or overwrite."""
    archive = REFRESH_ARCHIVE / f"skills-refresh-{time.strftime('%Y%m%d')}" / skill_id
    if archive.exists() or archive.is_symlink():
        raise FileExistsError(f"refresh archive already exists, refusing to overwrite: {archive}")
    archive.parent.mkdir(parents=True, exist_ok=True)
    os.rename(target_dir, archive)
    return archive


def _materialize(skill_dir, target_dir, link=False):
    target_dir = Path(target_dir)
    parent = target_dir.parent
    cursor = parent
    while cursor != cursor.parent:
        if cursor.is_symlink():
            raise ValueError(f"target parent may not be a symlink: {cursor}")
        cursor = cursor.parent
    target_dir.parent.mkdir(parents=True, exist_ok=True)
    lock = target_dir.parent / f".{target_dir.name}.install-lock"
    try:
        os.mkdir(lock)
    except FileExistsError:
        raise FileExistsError(f"another install is in progress for: {target_dir}")
    try:
        if target_dir.exists() or target_dir.is_symlink():
            if link and target_dir.is_symlink() and target_dir.resolve() == skill_dir.resolve():
                return "unchanged"
            if not link and target_dir.is_dir() and _same_projection(skill_dir, target_dir):
                return "unchanged"
            raise FileExistsError(f"refusing to overwrite existing target: {target_dir}")
        # mkdir is an exclusive no-replace claim, including when a competing
        # process creates the target between preflight and materialization.
        if link:
            os.symlink(skill_dir.resolve(), target_dir)
        else:
            os.mkdir(target_dir)
            try:
                # Expose the discovery entrypoint last. On failure retain the
                # incomplete target for inspection rather than deleting a path
                # another writer may have touched after our exclusive claim.
                for child in sorted(skill_dir.iterdir(), key=lambda p: p.name == 'SKILL.md'):
                    destination = target_dir / child.name
                    if child.is_dir() and not child.is_symlink():
                        shutil.copytree(child, destination, symlinks=True)
                    else:
                        shutil.copy2(child, destination, follow_symlinks=False) if not child.is_symlink() else os.symlink(os.readlink(child), destination)
            except Exception as exc:
                raise OSError(f"incomplete target retained for inspection: {target_dir}: {exc}") from exc
    finally:
        shutil.rmtree(lock, ignore_errors=True)
    return "installed"


def load_registry():
    """Load the skills registry. Returns empty dict if file doesn't exist."""
    if not REGISTRY_FILE.exists():
        return {"skills": []}
    with open(REGISTRY_FILE) as f:
        return json.load(f)


def save_registry(data):
    with open(REGISTRY_FILE, 'w') as f:
        json.dump(data, f, indent=2)


def cmd_list(args):
    """List all skills"""
    registry = load_registry()
    skills = [s for s in registry.get('skills', []) if getattr(args, 'all', False) or (s.get('metadata') or {}).get('status') not in {'dormant', 'archived'}]

    if not skills:
        print("[]" if args.json else "No skills found in registry.")
        return 0

    if args.category:
        skills = [s for s in skills if s.get('category') == args.category]

    if args.json:
        print(json.dumps(skills, indent=2))
        return 0

    print(f"{'SKILL ID':<20} {'NAME':<25} {'CATEGORY':<15} {'STATUS'}")
    print("-" * 70)
    for s in skills:
        print(f"{s['skill_id']:<20} {s['name']:<25} {s.get('category', 'N/A'):<15} {(s.get('metadata') or {}).get('status', 'N/A')}")

    if TELEMETRY_ENABLED:
        track("list", success=True, context=f"category:{args.category or 'all'}")
    return 0


def cmd_search(args):
    """Search skills"""
    registry = load_registry()
    query = args.query.lower()

    results = [
        s for s in registry.get('skills', [])
        if (getattr(args, 'all', False) or (s.get('metadata') or {}).get('status') not in {'dormant', 'archived'}) and (query in s['skill_id'].lower()
        or query in s['name'].lower()
        or query in s.get('description', '').lower()
        or any(query in tag.lower() for tag in s.get('tags', [])))
    ]

    if not results:
        print(f"No skills found matching '{args.query}'")
        if TELEMETRY_ENABLED:
            track("search", success=False, context=f"query:{args.query}")
        return 0

    for s in results:
        print(f"{s['skill_id']}: {s.get('description', '')}")
        print(f"  Tags: {', '.join(s.get('tags', []))}")
        print()

    if TELEMETRY_ENABLED:
        track("search", success=True, context=f"query:{args.query}")
    return 0


def cmd_info(args):
    """Show skill details"""
    registry = load_registry()
    skill = next((s for s in registry.get('skills', []) if s['skill_id'] == args.skill_id), None)

    if not skill:
        print(f"Error: Skill '{args.skill_id}' not found")
        if TELEMETRY_ENABLED:
            track(args.skill_id, success=False, error_type="not_found", context="info")
        return 1

    print(f"Skill ID: {skill['skill_id']}")
    print(f"Name: {skill['name']}")
    print(f"Description: {skill['description']}")
    print(f"Category: {skill.get('category', 'N/A')}")
    print(f"Tags: {', '.join(skill.get('tags', []))}")
    print(f"Version: {skill.get('version', 'N/A')}")
    print(f"Author: {skill.get('author', 'N/A')}")
    print(f"Status: {skill.get('metadata', {}).get('status', 'N/A')}")
    print(f"Dependencies: {skill.get('dependencies', {})}")

    if TELEMETRY_ENABLED:
        track(args.skill_id, success=True, context="info")
    return 0


def find_skill_dir(skill_id):
    """Find a skill directory by searching category subdirs recursively."""
    entry = next((s for s in load_registry().get('skills', []) if s['skill_id'] == skill_id), {})
    if entry.get('source_path'):
        return source_root(entry)
    candidate = SKILLS_DIR / entry.get('category', '') / skill_id
    return candidate if candidate.is_dir() else None


def resolve_agent_skill_path(agent_name, skill_dir):
    """
    Resolve the correct per-agent skill installation path.

    Pattern 1: <agent>/.claude/skills/<skill_id>/  — full skills (has SKILL.md + scripts)
    Pattern 2: <agent>/skills/<skill_id>/           — bare script skills (no SKILL.md)

    Detection: if skill has SKILL.md at root, use Pattern 1.
    """
    # Walk up to find workspace root (contains agents/ dir)
    workspace = skill_dir
    while workspace != workspace.parent:
        if (workspace / "agents").exists():
            break
        workspace = workspace.parent

    agent_base = workspace / "agents" / agent_name
    if not agent_base.exists():
        agent_base = Path(os.path.expanduser("~")) / "agents" / agent_name

    has_skill_md = (skill_dir / "SKILL.md").exists()
    if has_skill_md:
        return agent_base / ".claude" / "skills" / skill_dir.name
    else:
        return agent_base / "skills" / skill_dir.name


def cmd_install(args):
    with ExitStack() as stack:
        return _install(args, stack)


def home_operation(operation, *values):
    import subprocess
    helper = HUB_ROOT.resolve().parents[1] / 'harness/stack/lib/skill-home.mjs'
    result = subprocess.run(['node', str(helper), operation, *map(str, values)], text=True, capture_output=True)
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip())
    return json.loads(result.stdout)


def cmd_doctor(args):
    try:
        # Doctor emits its structured report even when problems are found.
        import subprocess
        helper = HUB_ROOT.resolve().parents[1] / 'harness/stack/lib/skill-home.mjs'
        return subprocess.run(['node', str(helper), 'doctor', str(Path.home())]).returncode
    except OSError as exc:
        print(f'Error: {exc}')
        return 1


def cmd_migrate(args):
    if (HUB_ROOT / 'registry/curation-20261021.json').is_file():
        import subprocess
        command = [sys.executable, str(HUB_ROOT/'scripts/apply_curation.py')]
        if args.dry_run:
            command.append('--dry-run')
        return subprocess.run(command).returncode
    names = set()
    broken = []
    for tool in ['.agents', '.claude', '.codex']:
        root = Path.home() / tool / 'skills'
        if root.exists():
            names.update(p.name for p in root.iterdir() if not p.name.startswith('.') and (p / 'SKILL.md').is_file())
            broken.extend(p for p in root.iterdir() if not p.name.startswith('.') and p.is_symlink() and not p.exists())
    entries = {name: s for s in load_registry()['skills'] for name in [s['skill_id'], *s.get('aliases', [])]}
    names.update(p.name for p in broken if p.name in entries)
    # Validate the entire installed set before archiving any projection.
    for name in sorted(names):
        if name not in entries:
            print(f'Error: register installed skill before migration: {name}')
            return 1
        entry = entries[name]
        _validate_source(entry['skill_id'], entry, find_skill_dir(entry['skill_id']))
    from types import SimpleNamespace
    for path in broken:
        if path.name not in entries:
            # No payload exists to migrate. Keep the dangling reference and its
            # restore receipt in the archive rather than leaving a broken discovery entry.
            if args.dry_run:
                print(f'Plan: archive unavailable dangling reference: {path}')
            else:
                print(json.dumps(home_operation('archive', path, Path.home())))
    for name in sorted(names):
        if cmd_install(SimpleNamespace(skill_id=name, agent=None, target=None, link=False, dry_run=args.dry_run)):
            return 1
    return 0 if args.dry_run else cmd_doctor(args)


def _install(args, stack):
    """Install skill to target (supports cloning from remote)"""
    import subprocess

    # Parse skill_id[@version] syntax
    skill_spec = args.skill_id
    version = None
    if '@' in skill_spec:
        skill_id, version = skill_spec.rsplit('@', 1)
    else:
        skill_id = skill_spec

    registry = load_registry()
    skill_entry = next((s for s in registry.get("skills", []) if s.get("skill_id") == skill_id or skill_id in s.get('aliases', [])), None)
    try:
        if not SAFE_ID.fullmatch(skill_id):
            raise ValueError(f"invalid skill ID: {skill_id}")
        if skill_entry is None:
            raise ValueError(f"Skill '{skill_id}' not found in registry")
        if not isinstance(skill_entry.get('category'), str) or not SAFE_ID.fullmatch(skill_entry['category']):
            raise ValueError('invalid skill category')
        if args.agent and not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', args.agent):
            raise ValueError('invalid agent name; use explicit --target for a path')
        if version:
            raise ValueError("caller-selected versions are refused; use the reviewed registry version/pin")
        if skill_entry.get("remote_url") and not re.fullmatch(r"[0-9a-f]{40}", skill_entry.get("commit_hash") or ""):
            raise ValueError("remote skill is missing a full reviewed commit SHA")
    except ValueError as exc:
        print(f"Error: {exc}")
        return 1

    # Find skill directory (search recursively in category subdirs)
    skill_dir = find_skill_dir(skill_entry['skill_id'])

    if not skill_dir and args.agent:
        print("Error: remote skills require explicit --target; staged source cannot establish an agent workspace")
        return 1
    if not skill_dir and args.link:
        print("Error: remote skills require copy installation; a temporary checkout cannot back a durable link")
        return 1

    # A dry run never clones, downloads, stages, or mutates Hub source.
    if args.dry_run and not skill_dir:
        if skill_entry.get("remote_url"):
            print(f"Plan: fetch reviewed remote {skill_id} at {skill_entry['commit_hash']} -> requested target")
        else:
            print(f"Error: Skill '{skill_id}' source is unavailable for dry-run")
            return 1
        return 0

    # If not found locally, try to clone from remote
    if not skill_dir:
        remote_url = skill_entry.get("remote_url") if skill_entry else None
        pinned_revision = skill_entry.get("commit_hash") if skill_entry else None

        if remote_url:
            print(f"Skill '{skill_id}' not found locally, cloning from {remote_url}...")
            # Clone to temporary location
            with tempfile.TemporaryDirectory() as tmpdir:
                clone_dir = Path(tmpdir) / skill_id
                try:
                    subprocess.run(["git", "clone", remote_url, str(clone_dir)],
                                 check=True, capture_output=True, text=True)

                    # Always materialize the exact reviewed commit recorded by the Hub.
                    subprocess.run(["git", "checkout", "--detach", pinned_revision],
                                     check=True, capture_output=True, text=True, cwd=clone_dir)

                    # Validate a temporary source snapshot; never mutate the Hub.
                    with tempfile.TemporaryDirectory() as staging:
                        staged = Path(staging) / skill_id
                        shutil.copytree(clone_dir, staged, ignore=shutil.ignore_patterns(".git"))
                        _validate_source(skill_id, skill_entry, staged, check_location=False)
                        # Keep the remote snapshot temporary; install only to the requested target.
                        if args.target:
                            target_dir = Path(args.target) / skill_id
                        else:
                            target_dir = Path.home() / '.agents/skills' / skill_id
                        result = _materialize(staged, target_dir) if args.target else home_operation('install', staged, skill_id, Path.home())
                        print(f"{'Linked' if args.link else 'Installed'} {skill_id} -> {target_dir}" + (" (unchanged)" if result == "unchanged" else ""))
                        if TELEMETRY_ENABLED:
                            track(skill_id, success=True, context="install")
                        return 0
                except (subprocess.CalledProcessError, ValueError, OSError) as e:
                    if not isinstance(e, subprocess.CalledProcessError):
                        print(f"Error installing remote skill: {e}")
                        return 1
                    print(f"Error cloning from {remote_url}: {e.stderr}")
                    return 1
        else:
            print(f"Error: Skill '{skill_id}' not found in registry and no remote_url set")
            if TELEMETRY_ENABLED:
                track(skill_id, success=False, error_type="not_found", context="install")
            return 1

    if not skill_dir:
        print(f"Error: Skill '{skill_id}' not found")
        if TELEMETRY_ENABLED:
            track(skill_id, success=False, error_type="not_found", context="install")
        return 1

    try:
        _validate_source(skill_id, skill_entry, skill_dir)
    except (ValueError, OSError) as exc:
        print(f"Error: validation failed: {exc}")
        return 1

    # Resolve target
    staging = None
    if skill_entry.get('source_path'):
        if args.link:
            print('Error: module sources require copy installation')
            return 1
        staging = stack.enter_context(tempfile.TemporaryDirectory(prefix='skills-module-'))
        staged = Path(staging) / skill_id
        staged.mkdir()
        for source in source_files(skill_entry, skill_dir):
            destination = staged / source.relative_to(skill_dir)
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
        skill_dir = staged
    if args.agent:
        target_dir = resolve_agent_skill_path(args.agent, skill_dir)
        print(f"Installing to agent '{args.agent}' (pattern: {'full' if (skill_dir / 'SKILL.md').exists() else 'bare'})")
    elif args.target:
        target_dir = Path(args.target) / skill_id
    else:
        target_dir = Path.home() / '.agents/skills' / skill_id

    if not args.agent and not args.target:
        if args.dry_run:
            print(f'Plan: canonical copy {skill_id} -> {target_dir}; Claude per-skill link; archive Codex duplicate')
            return 0
        try:
            result = home_operation('install', skill_dir, skill_id, Path.home())
        except (ValueError, OSError) as exc:
            print(f'Error: {exc}')
            return 1
        print(json.dumps(result))
        return 0

    refresh = getattr(args, 'refresh', False) and not args.link and _outdated_copy(target_dir, skill_dir, skill_id)
    if args.dry_run:
        if target_dir.exists() or target_dir.is_symlink():
            same = (args.link and target_dir.is_symlink() and target_dir.resolve() == skill_dir.resolve()) or (not args.link and not target_dir.is_symlink() and target_dir.is_dir() and _same_projection(skill_dir, target_dir))
            if not same and not refresh:
                print(f"Error: existing projection differs: {target_dir}")
                return 1
        print(f"Plan: {'link' if args.link else 'copy'} {skill_id} -> {target_dir}" + (" after archiving the outdated copy" if refresh else ""))
        return 0
    archived = None
    try:
        if refresh:
            archived = _archive_outdated(target_dir, skill_id)
        result = _materialize(skill_dir, target_dir, link=args.link)
    except (ValueError, OSError, shutil.Error) as exc:
        print(f"Error: install refused: {exc}" + (f"; outdated copy is archived at {archived}" if archived else ""))
        return 1
    print(f"{'Linked' if args.link else 'Installed'} {skill_id} -> {target_dir}" + (" (unchanged)" if result == "unchanged" else "") + (f" (outdated copy archived at {archived})" if archived else ""))

    if TELEMETRY_ENABLED:
        track(skill_id, success=True, context="install")
    return 0


def cmd_update(args):
    """Update skill from registry"""
    print("Update not implemented yet")
    return 0


def cmd_validate(args):
    """Validate skill structure"""
    skill_id = args.skill_id

    # Check registry
    registry = load_registry()
    skill_entry = next((s for s in registry.get('skills', []) if s['skill_id'] == skill_id or skill_id in s.get('aliases', [])), None)

    if not skill_entry:
        print(f"Error: Skill '{skill_id}' not found in registry")
        return 1

    # Check skill directory
    skill_dir = find_skill_dir(skill_entry['skill_id'])
    if not skill_dir:
        print(f"Error: Skill directory for '{skill_id}' not found")
        return 1

    try:
        _validate_source(skill_id, skill_entry, skill_dir)
    except (ValueError, OSError) as exc:
        print(f"Validation FAILED: {exc}")
        return 1

    print(f"Validation PASSED: {skill_id} has all required files")
    return 0


def cmd_strategist(args):
    """Score skill candidates against agents"""
    from skills_strategist import main as strategist_main
    sys.argv = ["skills_strategist"]
    if args.json:
        sys.argv.append("--json")
    if args.candidate:
        sys.argv.extend(["--candidate", args.candidate])
    return strategist_main()


def cmd_recommend(args):
    """Show skill recommendations based on co-invocation"""
    from skills_recommend import recommend, get_coinvocations
    import json

    if args.skill_id:
        recs = recommend(args.skill_id, top_n=args.top_n)
        if not recs:
            print(f"No co-invocation data for '{args.skill_id}' yet.")
            print("(This improves as skills are used more)")
            return 0

        print(f"Skills often used with '{args.skill_id}':")
        for co_skill, count, prob in recs:
            bar = "█" * int(prob * 20)
            print(f"  {co_skill:<20} {bar} {prob*100:.0f}%  (seen {count}x)")
    else:
        # Show all top pairs
        recs = get_coinvocations()
        print(f"{'SKILL':<20} {'OFTEN WITH':<20} {'PROB':<8} {'COUNT'}")
        print("-" * 60)
        shown = 0
        for skill_id, rec_list in sorted(recs.items()):
            for co_skill, count, prob in rec_list[:2]:
                print(f"{skill_id:<20} {co_skill:<20} {prob*100:>5.1f}%  {count}x")
                shown += 1
                if shown >= 20:
                    break
            if shown >= 20:
                break
    return 0


def cmd_health(args):
    """Show health scores for skills"""
    # If --monitor flag, run the full health monitor report
    if args.monitor:
        from skills_health_monitor import main as monitor_main
        sys.argv = ["skills_health_monitor"]
        if args.json:
            sys.argv.append("--json")
        sys.argv.extend(["--days", str(args.days)])
        return monitor_main()

    from skills_telemetry import get_db, get_stats

    registry = load_registry()
    skills = registry.get('skills', [])

    # Filter by skill_id if specified
    if args.skill:
        skills = [s for s in skills if s['skill_id'] == args.skill]
        if not skills:
            print(f"Error: Skill '{args.skill}' not found in registry")
            return 1

    results = []

    for skill in skills:
        sid = skill['skill_id']
        stats = get_stats(sid, days=30)
        count = stats['count']
        success_rate = stats['success_rate'] or 1.0
        avg_dur = stats['avg_duration_ms'] or 0
        unique_agents = stats['unique_agents'] or 1

        # Health formula
        usage_score = min(count / 100, 1.0)  # normalize to 100 invocations = max
        latency_score = max(0, 1 - (avg_dur / 10000))  # 10s = 0, 0ms = 1
        diversity_score = min(unique_agents / 5, 1.0)  # 5 agents = max

        health = usage_score * success_rate * latency_score * diversity_score
        health_pct = int(health * 100)

        results.append({
            'skill_id': sid,
            'health': health_pct,
            'invocations_30d': count,
            'success_rate': f"{success_rate*100:.1f}%",
            'avg_ms': int(avg_dur) if avg_dur else 0,
            'agents': unique_agents
        })

    results.sort(key=lambda x: x['health'])

    if args.json:
        print(json.dumps(results, indent=2))
        return 0

    print(f"{'SKILL ID':<20} {'HEALTH':<8} {'USAGE':<8} {'SUCCESS':<10} {'AVG_MS':<8} {'AGENTS'}")
    print("-" * 70)
    for r in results:
        bar = "█" * (r['health'] // 10) + "░" * (10 - r['health'] // 10)
        print(f"{r['skill_id']:<20} {bar} {r['health']:>3}%  "
              f"{r['invocations_30d']:>6}   {r['success_rate']:<10} "
              f"{r['avg_ms']:>6}ms  {r['agents']}")

    if TELEMETRY_ENABLED:
        track("health", success=True, context=f"skill:{args.skill or 'all'}")
    return 0


def cmd_depsolve(args):
    """Show dependency resolution for a skill"""
    from skills_deps import SkillDeps
    deps = SkillDeps(REGISTRY_FILE)
    result = deps.resolve_all(args.skill_id)

    if result['cycles']:
        print(f"CYCLE DETECTED: {result['cycles']}")
    if result['diamonds']:
        print(f"DIAMOND DEPS: {result['diamonds']}")

    print(f"\nInstall order for '{args.skill_id}':")
    for i, s in enumerate(result['install_order']):
        print(f"  {i+1}. {s}")

    if args.json:
        print(json.dumps(result, indent=2))

    return 0


def cmd_pipeline(args):
    """Run or list pipelines"""
    from skills_pipeline import run_pipeline, list_pipelines
    if args.subcommand == "list":
        list_pipelines()
        return 0
    elif args.subcommand == "run":
        return run_pipeline(args.pipeline, args.input, args.error_mode, args.json)


def cmd_publish(args):
    """Publish a skill (tag version, record commit)"""
    import subprocess

    skill_id = args.skill_id

    # Find skill dir
    skill_dir = find_skill_dir(skill_id)
    if not skill_dir:
        print(f"Error: Skill '{skill_id}' not found")
        return 1

    # Check if it's a git repo
    is_git = (skill_dir / ".git").exists()

    commit_hash = None
    if is_git:
        result = subprocess.run(["git", "rev-parse", "HEAD"],
                                capture_output=True, text=True, cwd=skill_dir)
        commit_hash = result.stdout.strip()[:8]

    # Read registry
    with open(REGISTRY_FILE) as f:
        registry = json.load(f)

    # Update skill entry
    for skill in registry["skills"]:
        if skill["skill_id"] == skill_id:
            skill["version"] = args.version or skill["version"]
            skill["commit_hash"] = commit_hash
            skill["remote_url"] = args.remote or skill.get("remote_url")
            skill["published_at"] = __import__("datetime").datetime.now().isoformat()
            break

    # Save registry
    with open(REGISTRY_FILE, "w") as f:
        json.dump(registry, f, indent=2)

    print(f"Published {skill_id}@{skill['version']}" +
          (f" ({commit_hash})" if commit_hash else ""))
    return 0


def cmd_versions(args):
    """List published versions of a skill"""
    skill_id = args.skill_id

    with open(REGISTRY_FILE) as f:
        registry = json.load(f)

    skill = next((s for s in registry["skills"] if s["skill_id"] == skill_id), None)
    if not skill:
        print(f"Error: Skill '{skill_id}' not found")
        return 1

    print(f"{skill_id} versions:")
    print(f"  current: {skill.get('version', 'N/A')}")
    print(f"  commit:  {skill.get('commit_hash', 'N/A')}")
    print(f"  remote:  {skill.get('remote_url', 'not set')}")
    print(f"  published: {skill.get('published_at', 'never')}")
    return 0


def cmd_agents(args):
    """Show all agents and their installed skills"""
    agents_dir = HUB_ROOT.parent / "agents"
    if not agents_dir.exists():
        print("No agents/ directory found")
        return 1

    registry = load_registry()
    skill_ids_in_hub = {s['skill_id'] for s in registry.get('skills', [])}

    agents_data = []
    for agent_dir in sorted(agents_dir.iterdir()):
        if agent_dir.name.startswith('.') or agent_dir.name in ('README.md', 'PLAN.md', 'registry.md'):
            continue
        if not agent_dir.is_dir():
            continue

        full_skills = []
        bare_skills = []

        claude_skills = agent_dir / ".claude" / "skills"
        if claude_skills.exists():
            for s in sorted(claude_skills.iterdir()):
                if s.name in ('README.md', 'registry.md'):
                    continue
                status = "linked" if s.is_symlink() else "installed"
                in_hub = "✓" if s.name in skill_ids_in_hub else "?"
                full_skills.append(f"{s.name} [{status}] {in_hub}")

        bare_skills_dir = agent_dir / "skills"
        if bare_skills_dir.exists():
            for s in sorted(bare_skills_dir.iterdir()):
                if s.name in ('README.md', 'registry.md'):
                    continue
                status = "linked" if s.is_symlink() else "installed"
                in_hub = "✓" if s.name in skill_ids_in_hub else "?"
                bare_skills.append(f"{s.name} [{status}] {in_hub}")

        agents_data.append({
            'name': agent_dir.name,
            'full_skills': full_skills,
            'bare_skills': bare_skills
        })

    if args.json:
        print(json.dumps(agents_data, indent=2))
        return 0

    for a in agents_data:
        print(f"\n{a['name']}")
        if a['full_skills']:
            print(f"  .claude/skills/: {', '.join(a['full_skills'])}")
        else:
            print(f"  .claude/skills/: (empty)")
        if a['bare_skills']:
            print(f"  skills/:          {', '.join(a['bare_skills'])}")
        else:
            print(f"  skills/:          (empty)")

    print(f"\n({len(agents_data)} agents scanned)")
    print("  ✓ = in hub registry   ? = not in hub registry")
    return 0


